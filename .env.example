# Copy to .env for local development. Replace every placeholder before deployment.
POSTGRES_DB=cyberlearn
POSTGRES_USER=cyberlearn
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://cyberlearn:local-development-only@db:5432/cyberlearn
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGINS=http://localhost:5173
API_ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development
VITE_API_URL=http://localhost:8000
